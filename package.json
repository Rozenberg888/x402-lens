{
  "name": "x402-lens-monorepo",
  "version": "0.2.1",
  "private": true,
  "description": "x402-lens — observability SDK + debugger for x402 v2 payments",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "vitest run --config vitest.live.config.ts",
    "example": "npm run start --workspace @x402-lens/example-express-weather",
    "version:set": "node scripts/version.mjs",
    "check:versions": "node scripts/check-workspace-versions.mjs",
    "check:dist": "node scripts/smoke-dist.mjs",
    "check:pack": "node scripts/check-package-contents.mjs",
    "fixtures:record": "tsx scripts/record-fixtures.mjs",
    "test:mutation": "stryker run",
    "release": "npm run check:versions && npm run typecheck && npm test && npm run build && npm run check:dist && npm run check:pack",
    "publish:npm": "node scripts/publish.mjs",
    "pages:build": "node scripts/build-pages.mjs"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^8.7.1",
    "@stryker-mutator/vitest-runner": "^8.7.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.4",
    "express": "^4.21.2",
    "fast-check": "^4.10.2",
    "marked": "^15.0.12",
    "tsup": "^8.4.0",
    "typescript": "^5.7.3",
    "vitest": "^2.1.9"
  }
}

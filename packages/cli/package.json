{
  "name": "@x402-lens/cli",
  "version": "0.2.4",
  "description": "CLI for x402-lens: inspect x402 v2 endpoints, explain failed payments, audit facilitator config",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rozenberg888/x402-lens.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/Rozenberg888/x402-lens#readme",
  "bugs": {
    "url": "https://github.com/Rozenberg888/x402-lens/issues"
  },
  "type": "module",
  "bin": {
    "x402-lens": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepublishOnly": "node ../../scripts/check-workspace-versions.mjs && npm --prefix ../.. run typecheck && npm run build && npm --prefix ../.. test"
  },
  "dependencies": {
    "@x402-lens/core": "0.2.4",
    "@x402/core": "^2.31.0"
  },
  "keywords": [
    "x402",
    "cli",
    "debugging",
    "payments"
  ]
}
